<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS config for the Angular skratchbastid SPA.
  Lives in public/ so the Angular build copies it to the site root
  (dist/skratchbastid/web.config) and it ships with every deploy.
-->
<configuration>
  <system.webServer>

    <!--
      Client-side routing: send any request that isn't a real file on disk
      to index.html so Angular's router can handle the route. We intentionally
      do NOT check IsDirectory here: if a leftover folder exists on the IIS
      server with the same name as an Angular route (e.g. /videos/), IIS
      would otherwise try to serve that directory's default document and
      return an empty 200 — producing a blank white screen on refresh.

      Real static assets are still served directly because they're requested
      by full path (e.g. /assets/foo.png) and IsFile resolves true.

      Exclusions:
        - version.json: deploy workflow reads the live version as a real file.
        - /assets, /img, /public: static asset roots, allow IIS to serve
          them normally (and 404 cleanly if missing) instead of falling back
          to the SPA index.
    -->
    <rewrite>
      <rules>
        <rule name="Angular SPA fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/version\.json$" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/(assets|img|public)(/|$)" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <!-- Make sure modern asset types are served with the right Content-Type. -->
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>

  </system.webServer>

  <!--
    index.html and version.json must never be cached, so browsers always pick
    up a new deploy immediately. The hashed JS/CSS bundles (outputHashing: all)
    have unique names per build, so they can be cached safely by default.
  -->
  <location path="index.html">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <remove name="Cache-Control" />
          <add name="Cache-Control" value="no-cache, no-store, must-revalidate" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
  <location path="version.json">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <remove name="Cache-Control" />
          <add name="Cache-Control" value="no-cache, no-store, must-revalidate" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>

</configuration>
